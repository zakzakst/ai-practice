// https://github.com/zakzakst/practice-ant-design/blob/main/package.json
{
  "$schema": "https://biomejs.dev/schemas/2.4.14/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "includes": ["src/**/*.astro", "src/**/*.css", "src/**/*.ts"]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "linter": {
    "enabled": true,
    "rules": {
      "recommended": true,
      "nursery": {
        // "useSortedClasses": {
        //   "level": "on",
        //   "options": {
        //     "attributes": ["class", "classList"],
        //     "functions": ["clsx", "cva", "tw", "tw.*"]
        //   }
        // },
        // "recommended": true,
        // "useSortedClasses": "error"
        // "noExcessiveSelectorClasses": {
        //   "level": "on",
        //   "options": {
        //     "maxClasses": 1
        //   }
        // }
      },

      "suspicious": {
        "noConsole": "error"
      }
    }
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "double"
    }
  },
  "assist": {
    "enabled": true,
    "actions": {
      "source": {
        "organizeImports": "on"
      }
    }
  }
}
