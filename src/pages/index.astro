import Activities from "@components/top/Activities.astro";

import Hero from "@components/top/Hero.astro";
import Member from "@components/top/Member.astro";
import Team from "@components/top/Team.astro";
import Layout from "@layouts/Default.astro";
---

<Layout title="トップページ" description="これはトップページです">
  <Hero />
  <div class="py-12">
    <Container>
      <Team />
    </Container>
    <Container className="mt-16">
      <Activities />
    </Container>
    <Container className="mt-16">
      <Member />
    </Container>
    <Container className="mt-16">
      <JoinUs />
    </Container>
  </div>
</Layout>
