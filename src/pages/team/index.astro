---
import Layout from "@layouts/Default.astro";
import Hero from "@components/common/Hero.astro";
import JoinUs from "@components/common/JoinUs.astro";

import Lead from "@components/team/Lead.astro";
import Feature from "@components/team/Feature.astro";
import Value from "@components/team/Value.astro";
---

<Layout title="チーム紹介ページ" description="これはチーム紹介ページです">
  <Hero
    title="チーム紹介"
    titleEn="TEAM"
    description="チームの考え方や雰囲気をお伝えします"
  />
  <div class="py-12">
    <Lead />
    <div class="mt-12">
      <Feature />
    </div>
    <div class="mt-12">
      <Value />
    </div>
    <div class="mt-12">
      <JoinUs />
    </div>
  </div>
</Layout>
