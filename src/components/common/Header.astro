---
import "@styles/common/header.css";
import Container from "@components/common/Container.astro";
import { getBasePath } from "@lib/utils";

type Item = {
  id: string;
  label: string;
  labelEn: string;
};
const items: Item[] = [
  {
    id: "team",
    label: "チーム紹介",
    labelEn: "TEAM",
  },
  {
    id: "activities",
    label: "活動情報",
    labelEn: "ACTIVITIES",
  },
  {
    id: "member",
    label: "メンバー",
    labelEn: "MEMBER",
  },
  {
    id: "news",
    label: "ニュース・実績",
    labelEn: "NEWS",
  },
];
---

<header class="header">
  <Container>
    <div class="grid gap-4 items-center grid-cols-[max-content_1fr]">
      <a class="header-link" href={getBasePath("/")}>
        <div class="header-link__logo">CHIMURA</div>
        <div>
          <p class="header-link__name">千村高校 バスケットボール部</p>
          <p class="header-link__name-en">
            CHIMURA HIGH SCHOOL BASKETBALL CLUB
          </p>
        </div>
      </a>
      <nav class="h-full ml-auto">
        <ul class="header-nav">
          {
            items.map((item) => (
              <li class="header-nav__item">
                <a class="header-nav__link" href={getBasePath(`/${item.id}`)}>
                  {item.labelEn}
                </a>
              </li>
            ))
          }
          <li class="header-nav__item">
            <a
              class="header-nav__link --contact"
              href={getBasePath(`/contact/`)}
            >
              CONTACT
            </a>
          </li>
        </ul>
      </nav>
    </div>
  </Container>
</header>
