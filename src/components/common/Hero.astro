---
import "@styles/common/hero.css";
import Container from "@components/common/Container.astro";

interface Props {
  title: string;
  titleEn: string;
  description: string;
  // TODO: 背景画像のパス
  // bgPath: string;
}
const { title, titleEn, description } = Astro.props;
---

<div class="hero">
  <Container className="h-full">
    <div class="hero-content">
      <hgroup>
        <p class="hero-content__sub-title">{titleEn}</p>
        <h1 class="hero-content__title">{title}</h1>
      </hgroup>
      <p class="hero-content__description">{description}</p>
    </div>
  </Container>
  <div class="hero-bg">
    <img src="https://placehold.jp/2000x480.png" alt="" loading="lazy" />
  </div>
</div>
