---
import "@styles/common/hero.css";
import Container from "@components/common/Container.astro";
import { getBasePath } from "@lib/utils";

interface Props {
  title: string;
  titleEn: string;
  description: string;
  bgPath?: string;
}
const { title, titleEn, description, bgPath } = Astro.props;
console.log("test");
---

<div class="hero">
  <Container className="h-full">
    <div class="hero-content">
      <hgroup>
        <p class="hero-content__sub-title">{titleEn}</p>
        <h1 class="hero-content__title">{title}</h1>
      </hgroup>
      <p class="hero-content__description">{description}</p>
    </div>
  </Container>
  <div class="hero-bg">
    <img
      src={bgPath ? getBasePath(bgPath) : "https://placehold.jp/2000x480.png"}
      alt=""
      loading="lazy"
    />
  </div>
</div>
