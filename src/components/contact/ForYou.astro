---
import "@styles/contact/for-you.css";

type Item = {
  text: string;
};
const items: Item[] = [
  {
    text: "バスケットボールが好きな人",
  },
  {
    text: "高校で何かに本気で取り組みたい人",
  },
  {
    text: "仲間と一緒に成長したい人",
  },
  {
    text: "経験の有無に関わらず挑戦したい人",
  },
];
---

<section>
  <h3 class="contact-for-you__heading">こんな人に向いています</h3>
  <ul class="mt-4">
    {items.map((item) => <li>{item.text}</li>)}
  </ul>
</section>
