---
import "@styles/contact/for-you.css";
import Heading from "@components/common/Heading.astro";

type Item = {
  text: string;
};
const items: Item[] = [
  {
    text: "バスケットボールが好きな人",
  },
  {
    text: "高校で何かに本気で取り組みたい人",
  },
  {
    text: "仲間と一緒に成長したい人",
  },
  {
    text: "経験の有無に関わらず挑戦したい人",
  },
];
---

<section>
  <Heading>こんな人を待っています</Heading>
  <div class="mt-4">
    <ul class="contact-for-you-items">
      {
        items.map((item) => (
          <li class="contact-for-you-item">
            <i />
            {item.text}
          </li>
        ))
      }
    </ul>
  </div>
</section>
