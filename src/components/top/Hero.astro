---
import "@styles/top/hero.css";
import Container from "@components/common/Container.astro";
import { getBasePath } from "@lib/utils";

const tickerText =
  "<span>SMALL <span>TEAM</span>. FULL <span>SPRINT</span>. FULL <span>VOICE</span>. FULL <span>COMMITMENT</span>.</span>";
---

<Container className="relative">
  <img src={getBasePath("/img/top/hero-bg.png")} alt="" loading="lazy" />
  <h1 class="top-hero-title">
    <img src={getBasePath("/img/top/title.png")} alt="" loading="lazy" />
  </h1>
</Container>

<div class="top-hero-ticker">
  <div class="top-hero-ticker__inner">
    <p class="top-hero-ticker__text">
      {
        Array(4)
          .fill(null)
          .map(() => <Fragment set:html={tickerText} />)
      }
    </p>
  </div>
</div>
