---
import "@styles/top/hero.css";
import Container from "@components/common/Container.astro";

const tickerText =
  "<span>SMALL <span>TEAM</span>. FULL <span>SPRINT</span>. FULL <span>VOICE</span>. FULL <span>COMMITMENT</span>.</span>";
---

<Container>
  <img src="https://placehold.jp/1600x900.png" alt="" loading="lazy" />
</Container>

<div class="top-hero-ticker">
  <div class="top-hero-ticker__inner">
    <p class="top-hero-ticker__text">
      {
        Array(4)
          .fill(null)
          .map(() => <Fragment set:html={tickerText} />)
      }
    </p>
  </div>
</div>
