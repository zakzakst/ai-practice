---
import "@styles/top/hero.css";
import Container from "@components/common/Container.astro";

const tickerText = "SMALL TEAM. FULL SPRINT. FULL VOICE. FULL COMMITMENT.";
---

<Container>
  <img src="https://placehold.jp/1600x900.png" alt="" loading="lazy" />
</Container>

<div class="top-hero-ticker">
  <div class="top-hero-ticker__inner">
    <p class="top-hero-ticker__text">
      {
        Array(4)
          .fill(null)
          .map(() => <span>{tickerText}</span>)
      }
    </p>
  </div>
</div>
