---
import "@styles/news/news.css";
import Heading from "@components/common/Heading.astro";
import { getBasePath } from "@lib/utils";

type Item = {
  id: number;
  date: string;
  category: string;
  title: string;
};

interface Props {
  items: Item[];
}
const { items } = Astro.props;
---

<section>
  <Heading>ニュース一覧</Heading>
  <div class="mt-4">
    <ul class="news-news-items">
      {
        items.map((item) => (
          <li class="news-news-item">
            <div>{item.date}</div>
            <div class="news-news-item__category">{item.category}</div>
            <div class="news-news-item__title">{item.title}</div>
            <a
              href={getBasePath(`/news/${item.id}`)}
              class="news-news-item__link"
            />
          </li>
        ))
      }
    </ul>
  </div>
</section>
